#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."
iconset="build/AppIcon.iconset"
rm -rf "$iconset"
mkdir -p build
swift scripts/make-icon.swift "$iconset"
iconutil -c icns "$iconset" -o Resources/AppIcon.icns
cp "$iconset/icon_128x128@2x.png" docs/icon.png
echo Resources/AppIcon.icns docs/icon.png
